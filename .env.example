# Sportsball Configuration
# Copy this file to .env and customize as needed

# NFL Season Configuration
SPORTSBALL_CURRENT_SEASON=2024
SPORTSBALL_CURRENT_WEEK=1

# Data Sources
SPORTSBALL_FFANALYTICS_SOURCES=["CBS", "ESPN", "FantasyPros", "FantasySharks", "FFToday", "NumberFire", "NFL", "RTSports"]

# API Configuration
SPORTSBALL_REQUEST_DELAY=2.0
SPORTSBALL_MAX_RETRIES=3
SPORTSBALL_TIMEOUT=30

# Model Configuration
SPORTSBALL_MODEL_RANDOM_STATE=42
SPORTSBALL_TEST_SIZE=0.2
SPORTSBALL_CV_FOLDS=5

# Optimization Configuration
SPORTSBALL_OPTIMIZATION_SOLVER=ECOS
SPORTSBALL_MAX_OPTIMIZATION_TIME=300

# Logging
SPORTSBALL_LOG_LEVEL=INFO
# SPORTSBALL_LOG_FILE=logs/sportsball.log
